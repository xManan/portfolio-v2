# Long random string. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=change-me
# SQLite database file (created by `npm run migrate`)
DATABASE_URI=file:./data/site.db
# Where uploaded images are stored
MEDIA_DIR=media
# Public URL of the site (used in links and the dashboard)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: email yourself when someone uses the contact form.
# Without these, messages still appear in the dashboard under Inbox.
# Works with any SMTP provider (Gmail app password, Resend, Postmark, Zoho...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_NOTIFY_TO=
