# Long random string. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=change-me
# SQLite database file (created by `npm run migrate`).
# On Vercel: your Turso URL (libsql://...) plus DATABASE_AUTH_TOKEN.
DATABASE_URI=file:./data/site.db
DATABASE_AUTH_TOKEN=
# Where uploaded images are stored
MEDIA_DIR=media
# Public URL of the site (used in links and the dashboard)
SITE_URL=http://localhost:3000

# Vercel only: uploads go to Vercel Blob when this is set (added for you when
# you connect a Blob store to the project).
BLOB_READ_WRITE_TOKEN=
